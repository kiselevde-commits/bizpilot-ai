# Docker Compose environment variables for BizPilot AI
# Copy to .env.docker and replace CHANGE_ME with real values.
# Do not commit .env.docker to Git.

POSTGRES_USER=bizpilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bizpilot

DATABASE_URL=postgresql://bizpilot:CHANGE_ME@postgres:5432/bizpilot?schema=public
SHADOW_DATABASE_URL=postgresql://bizpilot:CHANGE_ME@postgres:5432/bizpilot_shadow?schema=public

AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_BASE_URL=http://localhost:3000

SEED_ADMIN_PASSWORD=CHANGE_ME

# AI: real provider by default. Mock is allowed ONLY when AI_PROVIDER=mock AND ALLOW_MOCK_AI=true.
AI_PROVIDER=openai-compatible
ALLOW_MOCK_AI=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
