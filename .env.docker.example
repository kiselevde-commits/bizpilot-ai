# Docker Compose environment variables for BizPilot AI
# Copy to .env.docker and replace CHANGE_ME with real values.
# Do not commit .env.docker to Git.

POSTGRES_USER=bizpilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bizpilot

DATABASE_URL=postgresql://bizpilot:CHANGE_ME@postgres:5432/bizpilot?schema=public
SHADOW_DATABASE_URL=postgresql://bizpilot:CHANGE_ME@postgres:5432/bizpilot_shadow?schema=public

AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_BASE_URL=http://localhost:3000

SEED_ADMIN_PASSWORD=CHANGE_ME

# AI: real provider by default. Mock is allowed ONLY when AI_PROVIDER=mock AND ALLOW_MOCK_AI=true.
AI_PROVIDER=openai-compatible
ALLOW_MOCK_AI=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

N8N_WEBHOOK_URL=http://n8n:5678/webhook/lead-created
N8N_WEBHOOK_SECRET=CHANGE_ME
N8N_CALLBACK_SECRET=CHANGE_ME
N8N_TIMEOUT_MS=10000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n container and its private PostgreSQL database (automation profile).
# These values are required only for `docker compose --profile automation up`.
N8N_PUBLIC_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_TIMEZONE=Europe/Moscow
BIZPILOT_BASE_URL=http://app:3000
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME
N8N_DEDUPE_DB_USER=n8n_dedupe
N8N_DEDUPE_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
