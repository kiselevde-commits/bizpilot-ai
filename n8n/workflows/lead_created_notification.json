    {
      "id": "post-callback",
      "name": "Post callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 20],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\n\nconst input = $input.first()?.json ?? {};\nconst idempotencyKey = String(input.idempotencyKey || '');\nconst status = input.status === 'failed' ? 'failed' : 'delivered';\nconst error =\n  status === 'failed'\n    ? String(input.error || 'Telegram delivery failed').slice(0, 500)\n    : null;\n\nif (!idempotencyKey) {\n  throw new Error('MISSING_IDEMPOTENCY_KEY');\n}\n\nconst secret = $env.N8N_CALLBACK_SECRET;\nconst baseUrl = String($env.BIZPILOT_BASE_URL || '').replace(/[/]+$/, '');\n\nif (!secret) throw new Error('N8N_CALLBACK_SECRET is not configured');\nif (!baseUrl) throw new Error('BIZPILOT_BASE_URL is not configured');\n\nconst body = JSON.stringify({\n  idempotencyKey,\n  status,\n  ...(String($execution.id || '')\n    ? { externalEventId: String($execution.id || '') }\n    : {}),\n  ...(error ? { error } : {}),\n});\n\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.' + body)\n  .digest('hex');\n\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: baseUrl + '/api/webhooks/n8n',\n  headers: {\n    'content-type': 'application/json',\n    'x-n8n-signature': signature,\n    'x-n8n-timestamp': timestamp,\n  },\n  body,\n});\n\nreturn [{ json: { callback: status, idempotencyKey } }];"
      },
