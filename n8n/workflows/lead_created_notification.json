    {
      "id": "verify-signature",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\n\nconst item = items[0]?.json ?? {};\nconst headers = item.headers ?? {};\nconst rawBody = item.body;\n\nif (typeof rawBody !== 'string') {\n  throw new Error('RAW_BODY_REQUIRED');\n}\n\nconst header = (name) => {\n  const key = Object.keys(headers).find((key) => key.toLowerCase() === name);\n  return key ? String(headers[key] ?? '') : '';\n};\n\nconst signature = header('x-bizpilot-signature').trim().toLowerCase();\nconst timestamp = header('x-bizpilot-timestamp').trim();\nconst secret = $env.N8N_WEBHOOK_SECRET;\n\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET is not configured');\nif (!/^[0-9]{1,12}$/.test(timestamp)) throw new Error('INVALID_TIMESTAMP');\n\nconst now = Math.floor(Date.now() / 1000);\nif (Math.abs(now - Number(timestamp)) > 300) {\n  throw new Error('STALE_TIMESTAMP');\n}\n\nconst expected = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.' + rawBody)\n  .digest('hex');\n\nconst expectedBuffer = Buffer.from(expected, 'utf8');\nconst signatureBuffer = Buffer.from(signature, 'utf8');\n\nif (\n  expectedBuffer.length !== signatureBuffer.length ||\n  !crypto.timingSafeEqual(expectedBuffer, signatureBuffer)\n) {\n  throw new Error('INVALID_SIGNATURE');\n}\n\nlet payload;\ntry {\n  payload = JSON.parse(rawBody);\n} catch {\n  throw new Error('INVALID_JSON');\n}\n\nif (!payload || typeof payload.idempotencyKey !== 'string' || !payload.idempotencyKey) {\n  throw new Error('INVALID_PAYLOAD');\n}\n\nif (payload.eventType !== 'lead.created') {\n  throw new Error('UNSUPPORTED_EVENT');\n}\n\nconst data = payload.data && typeof payload.data === 'object' ? payload.data : {};\n\nreturn [{\n  json: {\n    idempotencyKey: payload.idempotencyKey,\n    payload: { ...payload, data },\n    rawBody,\n  },\n}];"
      }
    },
