# Database
DATABASE_URL=postgresql://bizpilot:CHANGE_ME@localhost:5432/bizpilot?schema=public
SHADOW_DATABASE_URL=postgresql://bizpilot:CHANGE_ME@localhost:5432/bizpilot_shadow?schema=public
POSTGRES_USER=bizpilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bizpilot

# Auth.js
AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Application
APP_BASE_URL=http://localhost:3000

# Seed (required, no default)
SEED_ADMIN_PASSWORD=CHANGE_ME

# AI (provider-independent; mock is allowed only for development/tests)
AI_PROVIDER=mock
ALLOW_MOCK_AI=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

# n8n / Telegram (Stage 4; leave empty until configured)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
